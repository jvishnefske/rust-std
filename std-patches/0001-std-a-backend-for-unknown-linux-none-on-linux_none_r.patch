+fn opendir(dirfd: c_int, p: &CStr, nofollow: bool) -> io::Result<OwnedFd> {
+    let mut flags = libc::O_CLOEXEC | libc::O_RDONLY | libc::O_DIRECTORY;
+    if nofollow {
+        flags |= libc::O_NOFOLLOW;
+    }
+    openat(dirfd, p, flags as u32, 0)
