 .../src/symbolize/gimli/libs_linux_none.rs    | 27 ++++++++++++
 .../src/symbolize/gimli/mmap_linux_none.rs    | 44 +++++++++++++++++++
 library/std/src/sys/pal/linux_none/mod.rs     | 18 ++++++++
 library/unwind/Cargo.toml                     |  5 +++
 library/unwind/src/libunwind.rs               |  4 +-
 library/unwind/src/types.rs                   |  4 +-
 7 files changed, 106 insertions(+), 4 deletions(-)
 create mode 100644 library/backtrace/src/symbolize/gimli/libs_linux_none.rs
 create mode 100644 library/backtrace/src/symbolize/gimli/mmap_linux_none.rs

