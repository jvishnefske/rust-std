diff --git a/library/std/src/sys/process/unix/linux_none.rs b/library/std/src/sys/process/unix/linux_none.rs
index aace917..8e0e7a7 100644
--- a/library/std/src/sys/process/unix/linux_none.rs
+++ b/library/std/src/sys/process/unix/linux_none.rs
