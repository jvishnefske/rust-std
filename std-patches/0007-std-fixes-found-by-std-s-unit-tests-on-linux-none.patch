+dependencies = [
+ "rustc-std-workspace-core",
+]
+
+[[package]]
+name = "linux_none_rt"
+version = "0.1.0"
 dependencies = [
  "rustc-std-workspace-core",
 ]
@@ -338,6 +343,7 @@ dependencies = [
  "hashbrown",
  "hermit-abi",
  "libc",
+ "linux_none_rt",
  "miniz_oxide",
  "moto-rt",
  "object",
diff --git a/library/std/src/os/fd/owned.rs b/library/std/src/os/fd/owned.rs
index c5144e5..a0cb500 100644
--- a/library/std/src/os/fd/owned.rs
+++ b/library/std/src/os/fd/owned.rs
@@ -211,6 +211,8 @@ impl FromRawFd for OwnedFd {
 #[stable(feature = "io_safety", since = "1.63.0")]
 impl Drop for OwnedFd {
     #[inline]
+    // linux-none closes with a safe call
+    #[cfg_attr(linux_none, allow(unused_unsafe))]
     fn drop(&mut self) {
         unsafe {
             // Note that errors are ignored when closing a file descriptor. According to POSIX 2024,
diff --git a/library/std/src/sys/fd/linux_none.rs b/library/std/src/sys/fd/linux_none.rs
index 8ad4635..dfb2a69 100644
--- a/library/std/src/sys/fd/linux_none.rs
+++ b/library/std/src/sys/fd/linux_none.rs
@@ -141,7 +141,8 @@ impl FileDesc {
 
     pub fn set_nonblocking(&self, nonblocking: bool) -> io::Result<()> {
         let v = nonblocking as libc::c_int;
-        cvt(unsafe { sys::ioctl(self.as_raw_fd(), libc::FIONBIO as usize, &v as *const _ as usize) })?;
+        let arg = (&raw const v).expose_provenance();
+        cvt(unsafe { sys::ioctl(self.as_raw_fd(), libc::FIONBIO as usize, arg) })?;
         Ok(())
     }
 
diff --git a/library/std/src/sys/io/error/linux_none.rs b/library/std/src/sys/io/error/linux_none.rs
index c9ebc79..3b9a751 100644
--- a/library/std/src/sys/io/error/linux_none.rs
+++ b/library/std/src/sys/io/error/linux_none.rs
@@ -1,17 +1,15 @@
 //! errno on linux-none: there is no libc errno, but `io::Error::last_os_error`
-//! and `set_errno` still need one, so it is a thread-local that the syscall
-//! wrappers' `cvt` records failures in.
+//! and `set_errno` still need one, so it is a thread-local (in the runtime,
+//! shared by every copy of std in the program) that the syscall wrappers'
+//! `cvt` records failures in.
 
 use crate::ffi::c_int;
 use crate::{fmt, io};
 
-#[thread_local]
-static mut ERRNO: c_int = 0;
-
 /// The address of this thread's errno (unique per thread).
 #[inline]
 pub fn errno_location() -> *mut c_int {
-    &raw mut ERRNO
+    linux_none_rt::errno::location()
 }
 
 #[inline]
diff --git a/library/std/src/sys/io/is_terminal/linux_none.rs b/library/std/src/sys/io/is_terminal/linux_none.rs
index b4a4db4..a20a89e 100644
--- a/library/std/src/sys/io/is_terminal/linux_none.rs
+++ b/library/std/src/sys/io/is_terminal/linux_none.rs
@@ -5,5 +5,6 @@ pub fn is_terminal(fd: &impl AsFd) -> bool {
     const TCGETS: usize = 0x5401;
     let mut termios = [0u8; 64];
     let fd = fd.as_fd().as_raw_fd();
-    unsafe { linux_none_rt::sys::ioctl(fd, TCGETS, termios.as_mut_ptr() as usize) }.is_ok()
+    let arg = termios.as_mut_ptr().expose_provenance();
+    unsafe { linux_none_rt::sys::ioctl(fd, TCGETS, arg) }.is_ok()
 }
diff --git a/library/std/src/sys/pal/linux_none/mod.rs b/library/std/src/sys/pal/linux_none/mod.rs
